# Copy this file to .env and fill in real values.

# Scanning goes through this repo's own backend (server/), which holds the
# Gemini API key server-side as the GEMINI_API_KEY env var -- never put a
# Gemini key here.
EXPO_PUBLIC_SCAN_URL=http://localhost:5050/api/v1/scan

# Supabase project settings (Settings -> API in the Supabase dashboard).
# The anon/public key is safe to expose client-side -- it's designed for
# that, and protected by Row Level Security on the Supabase tables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The "Fetch New Items" button on the Catalog screen calls this.
EXPO_PUBLIC_ITEMS_URL=http://localhost:5050/api/v1/items

# The "Upload All Payments" button on the Today's Bills screen calls this.
EXPO_PUBLIC_BILLS_URL=http://localhost:5050/api/v1/bills

# The "Sync QR Codes" button on the Payment QR Codes screen calls this.
EXPO_PUBLIC_QRCODES_URL=http://localhost:5050/api/v1/qrcodes

# Where the "forgot PIN" recovery email link should send the shopkeeper for
# native builds -- matches app.json's "scheme". Must also be added under
# Authentication -> URL Configuration -> Redirect URLs in Supabase.
EXPO_PUBLIC_RESET_PIN_URL=grocerybilling://reset-pin