# react-native-ping (a dependency of the thermal receipt printer library)
# declares a peer dependency range on react-native that doesn't include the
# version this project uses, even though it works fine in practice for our
# Bluetooth/network-only usage. Without this, `npm install` fails outright
# with an ERESOLVE conflict on any machine that doesn't pass
# --legacy-peer-deps by hand -- including Render's build, which uses a
# plain `npm install`.
legacy-peer-deps=true
